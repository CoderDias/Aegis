    private void PublishHeatmapOverlayPoints(IReadOnlyList<MapFeatureDto> features)
    {
        var points = new List<(double Lat, double Lng, double Weight)>();
        foreach (var feature in features)
        {
            var weight = MapFeatureLayers.IsRadioTower(feature) ? 1.4
                : MapFeatureLayers.IsRepeater(feature) ? 1.3
                : MapFeatureLayers.IsPoi(feature) ? 1.1
                : MapFeatureLayers.IsBuilding(feature) ? 0.7
                : 0.5;
            points.Add((feature.Centroid.Lat, feature.Centroid.Lng, weight));
        }

        if (HeatmapPointsEqual(Workspace.HeatmapOverlayPoints, points))
        {
            return;
        }

        Workspace.HeatmapOverlayPoints = points;
        if (Workspace.Layers.Heatmap)
        {
            Workspace.NotifyHeatmapOverlayChanged();
        }
    }

    private static bool HeatmapPointsEqual(
        IReadOnlyList<(double Lat, double Lng, double Weight)> current,
        IReadOnlyList<(double Lat, double Lng, double Weight)> next)
    {
        if (current.Count != next.Count)
        {
            return false;
        }

        for (var i = 0; i < current.Count; i++)
        {
            var a = current[i];
            var b = next[i];
            if (Math.Abs(a.Lat - b.Lat) > 0.000001 ||
                Math.Abs(a.Lng - b.Lng) > 0.000001 ||
                Math.Abs(a.Weight - b.Weight) > 0.000001)
            {
                return false;
            }
        }

        return true;
    }

    private IReadOnlyList<MapFeatureDto> FilterFeatures(IReadOnlyList<MapFeatureDto> features)
    {
        var list = new List<MapFeatureDto>();
        foreach (var feature in features)
        {
            if (Workspace.Layers.RadioTowers && IsRegionalIntelZoom && MapFeatureLayers.IsRadioTower(feature))
            {
                list.Add(feature);
            }
            else if (Workspace.Layers.Repeaters && IsRegionalIntelZoom && MapFeatureLayers.IsRepeater(feature))
            {
                list.Add(feature);
            }
            else if (Workspace.Layers.Erbs && IsOsmMediumZoom && MapFeatureLayers.IsErb(feature))
            {
                list.Add(feature);
            }
            else if (Workspace.Layers.PublicCameras && IsDetailedZoom && MapFeatureLayers.IsPublicCamera(feature))
            {
                list.Add(feature);
            }
            else if (Workspace.Layers.Ports && IsOsmMediumZoom && MapFeatureLayers.IsPort(feature))
            {
                list.Add(feature);
            }
            else if (Workspace.Layers.Roads && IsOsmMediumZoom && MapFeatureLayers.IsRoad(feature))
            {
                list.Add(feature);
            }
            else if (Workspace.Layers.Buildings && IsOsmMediumZoom && MapFeatureLayers.IsBuilding(feature))
            {
                list.Add(feature);
            }
            else if (Workspace.Layers.AreasOfInterest && IsOsmMediumZoom && MapFeatureLayers.IsPoi(feature))
            {
                list.Add(feature);
            }
        }

        return list
            .DistinctBy(f => $"{f.OsmType}/{f.OsmId}")
            .ToList();
    }

    private static string ComputeHostFocusKey(BoundingBoxDto bbox)
    {
        var focus = ViewportHostFocus.BuildFocusBbox(bbox);
        var lat = (focus.South + focus.North) / 2;
        var lng = (focus.West + focus.East) / 2;
        return $"{lat:F2}:{lng:F2}";
    }

    public async ValueTask DisposeAsync()
    {
        Workspace.Changed -= OnWorkspaceChanged;
        RansomwareCache.Updated -= OnRansomwareCacheUpdated;
        GeoIntelCache.Updated -= OnGeoIntelCacheUpdated;
        RegionalPrefetch.CountryUpdated -= OnRegionalPrefetchUpdated;
        ViewportBroker.ViewerDisconnected(_circuitId);

        if (_initialized)
        {
            try
            {
                await Js.InvokeVoidAsync("aegisMap.destroy", _elementId);
            }
            catch (JSDisconnectedException)
            {
                // circuit já desconectado
            }
        }

        _dotNetRef?.Dispose();
    }

