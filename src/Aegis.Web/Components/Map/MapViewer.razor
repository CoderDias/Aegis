    private async Task EnsureHostCacheAsync(BoundingBoxDto bbox)
    {
        if (_hostCacheByIp.Count == 0 && Workspace.ShodanRegionCache.Count > 0)
        {
            MergeHostsIntoCache(Workspace.ShodanRegionCache);
        }

        if (_hostCacheByIp.Count > 0)
        {
            return;
        }

        var context = await ViewportHostGeocoding.ResolveAsync(ScopeFactory, bbox, CancellationToken.None);
        if (context is not null)
        {
            _hostFocusIngestKey = context.IngestKey;
            var countryHosts = await HostRepository.ListByCountryAsync(context.CountryCode, 500);
            if (countryHosts.Count > 0)
            {
                MergeHostsIntoCache(countryHosts.Select(HostDtoMapper.ToDto));
                return;
            }
        }

        var persisted = await HostRepository.ListInViewportAsync(
            string.Empty,
            bbox.South,
            bbox.North,
            bbox.West,
            bbox.East);

        if (persisted.Count > 0)
        {
            MergeHostsIntoCache(persisted.Select(HostDtoMapper.ToDto));
            return;
        }

        if (context is not null)
        {
            return;
        }

        context = await ViewportHostGeocoding.ResolveAsync(ScopeFactory, bbox, CancellationToken.None);
        if (context is not null)
        {
            _hostFocusIngestKey = context.IngestKey;
        }
    }

