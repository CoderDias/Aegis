    [JSInvokable]
    public async Task OnMarkerClick(MarkerPayload payload)
    {
        var kind = ResolveClickKind(payload);
        var feature = ResolveFeatureForClick(payload.Id, kind, payload);

        await MarkerClicked.InvokeAsync((kind, payload.Id, feature));
    }

    private static string ResolveClickKind(MarkerPayload payload)
    {
        if (payload.Kind is "public_camera" or "erb" or "port")
        {
            return payload.Kind;
        }

        if (payload.Id.StartsWith("brazuca-camera/", StringComparison.OrdinalIgnoreCase))
        {
            return "public_camera";
        }

        if (payload.Id.StartsWith("anatel-erb/", StringComparison.OrdinalIgnoreCase))
        {
            return "erb";
        }

        if (payload.Id.StartsWith("brazuca-port/", StringComparison.OrdinalIgnoreCase))
        {
            return "port";
        }

        return payload.Kind;
    }

    private MapFeatureDto? ResolveFeatureForClick(string id, string kind, MarkerPayload payload)
    {
        if (_featureIndex.TryGetValue(id, out var indexed))
        {
            return indexed;
        }

        if (kind is not ("public_camera" or "erb" or "port"))
        {
            var cached = _cachedFeatures.FirstOrDefault(f =>
                string.Equals($"{f.OsmType}/{f.OsmId}", id, StringComparison.OrdinalIgnoreCase));
            if (cached is not null)
            {
                return cached;
            }

            return null;
        }

        var fromCache = _cachedFeatures.FirstOrDefault(f =>
            string.Equals($"{f.OsmType}/{f.OsmId}", id, StringComparison.OrdinalIgnoreCase));
        if (fromCache is not null)
        {
            return fromCache;
        }

        var catalog = kind switch
        {
            "public_camera" => PublicCameraCatalog.TryGetByCompositeId(id),
            "erb" => AnatelErbCatalog.TryGetByCompositeId(id),
            "port" => BrazilPortCatalog.TryGetByCompositeId(id),
            _ => null
        };
        if (catalog is not null)
        {
            return catalog;
        }

        return BuildFallbackFeature(id, kind, payload);
    }

    private static MapFeatureDto? BuildFallbackFeature(string id, string kind, MarkerPayload payload)
    {
        var slash = id.IndexOf('/');
        if (slash <= 0 || slash >= id.Length - 1 || !long.TryParse(id[(slash + 1)..], out var osmId))
        {
            return null;
        }

        var osmType = id[..slash];
        var expectedType = kind switch
        {
            "public_camera" => "brazuca-camera",
            "erb" => "anatel-erb",
            "port" => "brazuca-port",
            _ => osmType
        };

        if (!string.Equals(osmType, expectedType, StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        var tags = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["source"] = expectedType
        };

        if (!string.IsNullOrWhiteSpace(payload.Name))
        {
            tags["name"] = payload.Name;
        }

        if (!string.IsNullOrWhiteSpace(payload.Url))
        {
            tags["url"] = payload.Url;
        }

        if (!string.IsNullOrWhiteSpace(payload.Operator))
        {
            tags["operator"] = payload.Operator;
        }

        if (!string.IsNullOrWhiteSpace(payload.Technology))
        {
            tags["technology"] = payload.Technology;
        }

        if (!string.IsNullOrWhiteSpace(payload.City))
        {
            tags["addr:city"] = payload.City;
        }

        if (!string.IsNullOrWhiteSpace(payload.State))
        {
            tags["addr:state"] = payload.State;
        }

        var lat = payload.Lat ?? 0;
        var lng = payload.Lng ?? 0;
        var geometry = payload.Lat is not null && payload.Lng is not null
            ? $$"""{"type":"Point","coordinates":[{{lng.ToString(System.Globalization.CultureInfo.InvariantCulture)}},{{lat.ToString(System.Globalization.CultureInfo.InvariantCulture)}}]}"""
            : null;

        return new MapFeatureDto(
            expectedType,
            osmId,
            payload.Name,
            payload.Category,
            new CoordinateDto(lat, lng),
            geometry,
            tags);
    }

