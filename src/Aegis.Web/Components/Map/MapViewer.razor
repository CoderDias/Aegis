        var merged = _cachedFeatures.ToDictionary(
            f => $"{f.OsmType}/{f.OsmId}",
            f => f,
            StringComparer.OrdinalIgnoreCase);

        foreach (var poi in StaticPoiCatalog.GetInViewport(bbox))
