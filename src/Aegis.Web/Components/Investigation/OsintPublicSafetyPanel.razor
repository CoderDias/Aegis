@using Aegis.Application.Abstractions
@using Aegis.Application.Dtos.Osint
@using Aegis.Application.Services
@inject IOsintBrazucaCatalog Catalog
@inject InvestigationService InvestigationService
@inject WorkspaceState Workspace
@inject UiNotificationService Notifications
@inject ProtectedLocalStorage LocalStorage
@inject IJSRuntime Js

<div class="aegis-osint-section">
    <div class="aegis-osint-section__title">Desaparecidos e procurados</div>
    <p class="aegis-osint-playbook-hint">Portais oficiais por UF — link-out apenas, sem coleta automatizada de PII.</p>

    <select class="aegis-input" @bind="_selectedUf" @bind:after="RefreshLinks">
        <option value="">Todas UFs</option>
        @foreach (var uf in _ufs)
        {
            <option value="@uf">@uf</option>
        }
    </select>

    @if (_missing.Count > 0)
    {
        <div class="aegis-osint-subsection__title">Pessoas desaparecidas</div>
        @foreach (var source in _missing)
        {
            <div class="aegis-osint-row">
                <div class="aegis-osint-row__main">
                    <strong>@source.Fonte</strong>
                    <div class="aegis-osint-row__meta">@(source.Uf ?? "BR") · @source.Categoria</div>
                </div>
                <button type="button" class="aegis-btn aegis-btn--ghost" style="font-size:10px" @onclick="() => OpenSourceAsync(source)">Abrir</button>
            </div>
        }
    }

    @if (_wanted.Count > 0)
    {
        <div class="aegis-osint-subsection__title">Pessoas procuradas</div>
        @foreach (var source in _wanted)
        {
            <div class="aegis-osint-row">
                <div class="aegis-osint-row__main">
                    <strong>@source.Fonte</strong>
                    <div class="aegis-osint-row__meta">@(source.Uf ?? "BR") · @source.Categoria</div>
                </div>
                <button type="button" class="aegis-btn aegis-btn--ghost" style="font-size:10px" @onclick="() => OpenSourceAsync(source)">Abrir</button>
            </div>
        }
    }

    @if (_missing.Count == 0 && _wanted.Count == 0)
    {
        <EmptyState Title="Nenhum portal" Description="Ajuste a UF ou aguarde o carregamento do catálogo." Icon="⌕" />
    }
</div>

@code {
    private const string LgpdStorageKey = "aegis_osint_lgpd_ack";

    private string _selectedUf = string.Empty;
    private IReadOnlyList<string> _ufs = [];
    private IReadOnlyList<OsintSourceDto> _missing = [];
    private IReadOnlyList<OsintSourceDto> _wanted = [];

    protected override void OnInitialized()
    {
        _ufs = Catalog.Search(new OsintSearchQuery(CategoriaId: "pessoas-desaparecidas", Limit: 500))
            .Concat(Catalog.Search(new OsintSearchQuery(CategoriaId: "pessoas-procuradas-pela-justica-no-brasil", Limit: 500)))
            .Select(s => s.Uf)
            .Where(uf => !string.IsNullOrWhiteSpace(uf))
            .Select(uf => uf!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(uf => uf, StringComparer.OrdinalIgnoreCase)
            .ToList();

        RefreshLinks();
    }

    private void RefreshLinks()
    {
        _missing = Catalog.Search(new OsintSearchQuery(
            CategoriaId: "pessoas-desaparecidas",
            Uf: string.IsNullOrWhiteSpace(_selectedUf) ? null : _selectedUf,
            Limit: 40));

        _wanted = Catalog.Search(new OsintSearchQuery(
            CategoriaId: "pessoas-procuradas-pela-justica-no-brasil",
            Uf: string.IsNullOrWhiteSpace(_selectedUf) ? null : _selectedUf,
            Limit: 40));
    }

    private async Task OpenSourceAsync(OsintSourceDto source)
    {
        try
        {
            var lgpd = await LocalStorage.GetAsync<bool>(LgpdStorageKey);
            if (lgpd.Success != true || lgpd.Value != true)
            {
                Notifications.Show("Confirme o aviso LGPD na seção Fontes OSINT antes de abrir links.", NotificationLevel.Warning);
                return;
            }
        }
        catch
        {
            Notifications.Show("Confirme o aviso LGPD na seção Fontes OSINT antes de abrir links.", NotificationLevel.Warning);
            return;
        }

        await Js.InvokeVoidAsync("open", source.Url, "_blank");

        if (Workspace.ActiveInvestigationId is Guid investigationId)
        {
            try
            {
                await InvestigationService.RecordOsintSourceAccessAsync(
                    investigationId,
                    source.Fonte,
                    source.Url);
            }
            catch (Exception ex)
            {
                Notifications.Show(ex.Message, NotificationLevel.Warning);
            }
        }
    }
}
