@using Aegis.Application.Dtos.Intel
@using Aegis.Application.Services
@inject RssFeedService News
@inject WorkspaceState Workspace
@inject ILogger<NewsPanel> Logger
@implements IDisposable

<div class="aegis-panel" style="border:none;background:transparent">
    <div class="aegis-panel__header" style="padding:0 0 8px">
        Notícias (@_filtered.Count)
        <button type="button" class="aegis-btn aegis-btn--ghost" style="font-size:10px;margin-left:auto" @onclick="ToggleFilter">
            @(_filterByViewport ? "Tudo" : "Viewport")
        </button>
    </div>
    @if (_loading)
    {
        <LoadingSpinner Label="Carregando feeds..." />
    }
    else if (_filtered.Count == 0)
    {
        <EmptyState Title="Nenhuma notícia" Description="@(_filterByViewport ? "Nenhuma notícia nesta região. Tente mover o mapa." : "Feeds RSS são atualizados a cada 30 min.")" Icon="▤" />
    }
    else
    {
        <div class="aegis-news-list">
            @foreach (var item in _filtered)
            {
                <article class="aegis-news-item">
                    <div class="aegis-news-item__meta">@item.FeedTitle · @item.PublishedAt.LocalDateTime.ToString("dd/MM HH:mm")</div>
                    <a class="aegis-news-item__title" href="@item.Link" target="_blank" rel="noopener">@item.Title</a>
                    @if (!string.IsNullOrWhiteSpace(item.Summary))
                    {
                        <p class="aegis-news-item__summary">@item.Summary</p>
                    }
                </article>
            }
        </div>
    }
</div>

@code {
    private IReadOnlyList<NewsItemDto> _items = [];
    private IReadOnlyList<NewsItemDto> _filtered = [];
    private bool _loading = true;
    private bool _filterByViewport = true;

    protected override async Task OnInitializedAsync()
    {
        Workspace.ViewportChanged += OnViewportChanged;
        await LoadAsync();
    }

    public void Dispose() => Workspace.ViewportChanged -= OnViewportChanged;

    private async void OnViewportChanged()
    {
        ApplyFilter();
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleFilter()
    {
        _filterByViewport = !_filterByViewport;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (!_filterByViewport || Workspace.Viewport is null)
        {
            _filtered = _items;
            return;
        }

        var bbox = Workspace.Viewport;
        _filtered = _items
            .Where(n => n.Lat is not null && n.Lng is not null &&
                        n.Lat >= bbox.South && n.Lat <= bbox.North &&
                        n.Lng >= bbox.West && n.Lng <= bbox.East)
            .ToList();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = await News.ListNewsAsync(500);
            ApplyFilter();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load news items.");
            _items = [];
            _filtered = [];
        }
        finally
        {
            _loading = false;
        }
    }
}

<style>
    .aegis-news-list { display: flex; flex-direction: column; gap: 10px; max-height: 100%; overflow-y: auto; }
    .aegis-news-item { padding: 8px; background: var(--bg-2); border: 1px solid var(--stroke); border-radius: 4px; }
    .aegis-news-item__meta { font-size: 10px; color: var(--text-2); margin-bottom: 4px; }
    .aegis-news-item__title { font-size: 12px; color: var(--accent); text-decoration: none; display: block; line-height: 1.3; }
    .aegis-news-item__title:hover { text-decoration: underline; }
    .aegis-news-item__summary { font-size: 11px; color: var(--text-1); margin: 4px 0 0; line-height: 1.35; }
</style>
